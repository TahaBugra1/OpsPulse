PORT=4000

# postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://postgres:postgres@localhost:5432/opspulse

# openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret

# Frontend origin allowed by CORS — no wildcard in any environment
CLIENT_ORIGIN=http://localhost:5173

# Corporate email domain allowed for self-registration (no leading @)
ALLOWED_EMAIL_DOMAIN=example.com

# Google OAuth client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Google Gemini API key for AI request-classification suggestions (optional —
# feature silently disables itself if unset). Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model to use for classification (see GEMINI_API_KEY above)
GEMINI_MODEL=gemini-2.0-flash
